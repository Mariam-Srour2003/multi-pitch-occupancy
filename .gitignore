# ---------------------------------------------------------------------------
# Data — client footage and derived frames. NEVER commit these.
# The dataset is referenced by data/dataset/manifest.csv, not stored here.
# ---------------------------------------------------------------------------
# Leading slash matters: an unanchored "data/" would also swallow the
# src/pitch_occupancy/data/ package.
/data/
*.mp4
*.avi
*.mkv
*.mov

# Model weights & trained heads (regenerable from cached features)
*.pt
*.pth
*.onnx
*.pkl
yolov8n.pt

# Feature caches
*.npz
/data/cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Evidence images and frames. Only documentation images are committed.
evidence_cache/
*.jpg
*.jpeg
*.png
!docs/**/*.png

# Generated reports (`pitch coverage` and similar) - regenerable, never source.
/results/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv.lock and .python-version ARE committed - they are what makes an install
# reproducible on another machine. Do not ignore them.

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Office lock files
~$*
.~lock.*

# Secrets / local config
# An RTSP URL carries the credentials for a camera watching identifiable people, and a
# committed one is a leak that outlives the commit. configs/cameras.example.json shows
# the shape; the real file never leaves the machine.
/configs/cameras.json
/configs/bookings_source.json
/configs/alerts.json
# Playgrounds (playgrounds.py): which cameras, how often, when; and this computer's speed.
/configs/playgrounds.json
/configs/computer_speed.json
/configs/monitor.json
.env
.env.*
secrets.json
config/*.local.json

# Schedule-editor backups: generated per write, pruned to the last 20, never source.
/configs/schedule_history/
# Camera-registry backups (the /cameras page): copies of cameras.json, so they hold credentials.
/configs/cameras_history/
data/interim/stage_runs.json
