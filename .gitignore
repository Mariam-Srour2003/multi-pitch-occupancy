# ---------------------------------------------------------------------------
# Data — client footage and derived frames. NEVER commit these.
# The dataset is referenced by data/dataset/manifest.csv (WP0-T2), not stored here.
# ---------------------------------------------------------------------------
data/
*.mp4
*.avi
*.mkv
*.mov

# Model weights & trained heads (regenerable from cached features)
*.pt
*.pth
*.onnx
*.pkl
yolov8n.pt

# Feature caches
*.npz
cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Evidence images / contact sheets
evidence_cache/
results/sheets/
*.jpg
*.jpeg
*.png
!docs/**/*.png

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Excel lock files (leaderboard.csv is often open — see SUPER_PLAN.md §2.2)
~$*
.~lock.*

# Secrets / local config
.env
.env.*
secrets.json
config/*.local.json
